	},
	"dependencies": {
		"drizzle-orm": "^0.44.0",
		"hono": "^4.7.0"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20250516.0",
		"drizzle-kit": "^0.31.0",
		"typescript": "^5.8.0",
		"wrangler": "^4.14.0"
	}
}
